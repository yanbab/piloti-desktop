[Desktop Entry]
Type=Application
Name=Folders
Comment=Browse local virtual files and folders
Exec=piloti-files %U
Icon=system-file-manager
Categories=System;FileManager;
MimeType=inode/directory;
OnlyShowIn=Piloti;
X-Piloti-AppId=nautilus
X-Piloti-Component=files
X-Piloti-ShortName=Folders
X-Piloti-Category=System
X-Piloti-Order=30
X-Piloti-Pinned=true
X-Piloti-IconName=folder
X-Piloti-XdgIcons=system-file-manager;org.gnome.Nautilus;piloti-files;
X-Piloti-Gradient=from-sky-400 via-blue-500 to-blue-600
X-Piloti-Size=780x500
