[Desktop Entry]
Type=Application
Name=App Store
Comment=Browse and install apps and web apps
Exec=piloti-appstore
Icon=system-software-install
Categories=System;PackageManager;
MimeType=application/vnd.debian.binary-package;application/vnd.flatpak.ref;application/vnd.flatpak;
OnlyShowIn=Piloti;
X-Piloti-AppId=app-store
X-Piloti-Component=app-store
X-Piloti-ShortName=App Store
X-Piloti-Category=System
X-Piloti-Order=60
X-Piloti-Pinned=true
X-Piloti-IconName=sparkles
X-Piloti-XdgIcons=system-software-install;org.gnome.Software;software-store;piloti-appstore;piloti-applications;
X-Piloti-Gradient=from-blue-500 via-indigo-500 to-violet-600
X-Piloti-Size=880x580
X-Piloti-MinSize=320x400
