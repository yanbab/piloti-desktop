[Desktop Entry]
Type=Application
Name=Notepad
Comment=Minimal plain-text notepad with instant localStorage VFS save
Exec=piloti-notepad %F
Icon=accessories-text-editor
Categories=Utility;TextEditor;
MimeType=text/plain;text/markdown;text/css;text/csv;application/json;application/xml;application/x-shellscript;application/x-yaml;application/x-desktop;
OnlyShowIn=Piloti;
X-Piloti-AppId=text-editor
X-Piloti-Component=text-editor
X-Piloti-ShortName=Notepad
X-Piloti-Category=Utilities
X-Piloti-Order=50
X-Piloti-Pinned=true
X-Piloti-IconName=file-text
X-Piloti-XdgIcons=accessories-text-editor;org.gnome.TextEditor;piloti-notepad;piloti-text-editor;
X-Piloti-Gradient=from-amber-400 via-orange-500 to-rose-500
X-Piloti-Size=520x380
