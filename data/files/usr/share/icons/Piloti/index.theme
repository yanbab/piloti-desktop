[Icon Theme]
Name=Piloti
Comment=Piloti Animated Icon Theme (Folder & Text Animations; Inherits Papirus & Adwaita)
Inherits=Papirus,Adwaita,hicolor
Directories=animated/places,animated/mimetypes,scalable/apps,scalable/mimetypes

[animated/places]
Context=Places
Size=64
MinSize=16
MaxSize=512
Type=Scalable

[animated/mimetypes]
Context=MimeTypes
Size=64
MinSize=16
MaxSize=512
Type=Scalable

[scalable/apps]
Context=Applications
Size=128
MinSize=16
MaxSize=512
Type=Scalable

[scalable/mimetypes]
Context=MimeTypes
Size=64
MinSize=16
MaxSize=512
Type=Scalable
