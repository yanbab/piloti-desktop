MinSize=16
MaxSize=512
Type=Scalable

[64x64/mimetypes]
Context=MimeTypes
Size=64
MinSize=16
MaxSize=512
Type=Scalable

[64x64/places]
Context=Places
Size=64
MinSize=16
MaxSize=512
Type=Scalable

[64x64/status]
Context=Status
Size=64
MinSize=16
MaxSize=512
Type=Scalable

[24x24/actions]
Context=Actions
Size=24
MinSize=16
MaxSize=512
Type=Scalable

[symbolic/actions]
