#!/usr/bin/env python3
"""
piloti-greetd-client — Minimal greetd-ipc(7) authentication & session handoff helper.

Reads a JSON object from stdin:
  {"username": "...", "password": "...", "cmd": [...], "env": [...]}

Communicates over $GREETD_SOCK using 4-byte native-endian uint32 length-prefixed
UTF-8 JSON frames and prints a JSON result:
  {"ok": true} or {"ok": false, "error": "..."}
"""
import json
import os
import socket
import struct
import sys


def _recv_exact(sock: socket.socket, n: int) -> bytes:
    chunks = []
    remaining = n
    while remaining > 0:
        data = sock.recv(remaining)
        if not data:
            raise EOFError("greetd socket closed unexpectedly")
        chunks.append(data)
        remaining -= len(data)
    return b"".join(chunks)


def send_msg(sock: socket.socket, payload: dict) -> dict:
    raw = json.dumps(payload).encode("utf-8")
    sock.sendall(struct.pack("=I", len(raw)) + raw)
    header = _recv_exact(sock, 4)
    (resp_len,) = struct.unpack("=I", header)
    body = _recv_exact(sock, resp_len)
    return json.loads(body.decode("utf-8"))


def cancel_quiet(sock: socket.socket) -> None:
    try:
        send_msg(sock, {"type": "cancel_session"})
    except Exception:
        pass


def main() -> int:
    sock_path = os.environ.get("GREETD_SOCK")
    if not sock_path:
        print(json.dumps({"ok": False, "error": "GREETD_SOCK is not set"}))
        return 2

    try:
        req = json.loads(sys.stdin.read() or "{}")
    except Exception as exc:
        print(json.dumps({"ok": False, "error": f"Invalid request JSON: {exc}"}))
        return 2

    username = str(req.get("username") or "").strip()
    password = str(req.get("password") or "")
    cmd = req.get("cmd") or ["/usr/bin/piloti-session"]
    env = req.get("env") or []

    if not username:
        print(json.dumps({"ok": False, "error": "Username is required"}))
        return 2

    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        sock.connect(sock_path)
        resp = send_msg(sock, {"type": "create_session", "username": username})

        password_sent = False
        for _ in range(10):
            rtype = resp.get("type")
            if rtype == "success":
                break
            if rtype == "error":
                desc = resp.get("description") or "Authentication failed."
                cancel_quiet(sock)
                print(json.dumps({"ok": False, "error": desc}))
                return 1
            if rtype == "auth_message":
                mtype = resp.get("auth_message_type")
                if mtype in ("secret", "visible"):
                    if password_sent:
                        cancel_quiet(sock)
                        print(
                            json.dumps(
                                {
                                    "ok": False,
                                    "error": resp.get("auth_message")
                                    or "Additional authentication required.",
                                }
                            )
                        )
                        return 1
                    password_sent = True
                    resp = send_msg(
                        sock,
                        {"type": "post_auth_message_response", "response": password},
                    )
                else:
                    # "info" or "error" PAM prompt: acknowledge with null response
                    resp = send_msg(
                        sock,
                        {"type": "post_auth_message_response", "response": None},
                    )
            else:
                cancel_quiet(sock)
                print(json.dumps({"ok": False, "error": f"Unexpected greetd reply: {rtype}"}))
                return 1

        if resp.get("type") != "success":
            cancel_quiet(sock)
            print(json.dumps({"ok": False, "error": "Authentication failed."}))
            return 1

        start_payload = {"type": "start_session", "cmd": cmd}
        if env:
            start_payload["env"] = env
        start_resp = send_msg(sock, start_payload)
        if start_resp.get("type") != "success":
            desc = start_resp.get("description") or "Failed to start desktop session."
            cancel_quiet(sock)
            print(json.dumps({"ok": False, "error": desc}))
            return 1

        print(json.dumps({"ok": True}))
        return 0
    except Exception as exc:
        cancel_quiet(sock)
        print(json.dumps({"ok": False, "error": str(exc)}))
        return 1
    finally:
        try:
            sock.close()
        except Exception:
            pass


if __name__ == "__main__":
    sys.exit(main())
