{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "xdg-basedir": ["./src/lib/xdg-basedir.ts"],
      "xdg-desktop-entry": ["./src/lib/xdg-desktop-entry.ts"],
      "xdg-icon-theme": ["./src/lib/xdg-icon-theme.ts"]
    }
  },
  "include": ["src", "desktop.tsx", "vite.config.ts", "vite.shell.config.ts"],
  "exclude": ["**/*.test.ts"]
}

