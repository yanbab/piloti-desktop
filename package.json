{
  "name": "piloti-desktop",
  "version": "0.10.12",
  "private": true,
  "description": "Piloti Desktop — A Linux Wayland desktop shell built on Domicile",
  "type": "module",
  "domicile": {
    "shell": "dist/shell.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.shell.config.ts",
    "build:web": "vite build",
    "build:shell": "vite build --config vite.shell.config.ts",
    "build:apps": "rm -rf dist/apps && for a in hello texts; do APP=$a vite build -c vite.apps.config.ts || exit 1; done",
    "build:greeter": "vite build --config vite.greeter.config.ts",
    "build:deb": "node scripts/build-deb.mjs",
    "preview": "vite preview",
    "test": "bun test tests/unit tests/functional",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@base-ui/react": "^1.0.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@cprussin/option-result": "2.0.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@domicile-desktop/react": "0.2.0",
    "@domicile-desktop/sdk": "3.0.0",
    "@domicile-desktop/system-audio": "1.2.0",
    "@domicile-desktop/system-backlight": "1.1.3",
    "@domicile-desktop/system-battery": "1.1.3",
    "@domicile-desktop/system-bluetooth": "1.1.3",
    "@domicile-desktop/system-network": "1.2.0",
    "@lezer/highlight": "^1.2.5",
    "@lezer/javascript": "^1.5.6",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.14.28",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "codejar": "^5.0.0",
    "jszip": "^3.10.2",
    "lottie-web": "^5.13.0",
    "lucide-react": "^1.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-obj-view": "^1.1.11",
    "tailwind-merge": "^3.2.0",
    "tw-animate-css": "^1.2.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8"
  }
}