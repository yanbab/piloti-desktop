[Icon Theme]
Name=Piloti
Comment=Piloti Animated Icon Theme (Papirus Lottie + Scalable Fallback)
Inherits=Papirus,hicolor
Directories=animated/apps,animated/places,animated/mimetypes,animated/status,scalable/apps,scalable/mimetypes

[animated/apps]
Context=Applications
Size=64
MinSize=16
MaxSize=512
Type=Scalable

